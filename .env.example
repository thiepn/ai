# OpenAI provider credential. Server-side only.
OPENAI_API_KEY=

# HMAC secrets for server-to-server application identities.
# Generate an independent random value (>=32 characters) for every app.
# Example placeholders only; never commit real secrets.
THIEPN_AI_APP_SECRETS_JSON={"internal":"replace-with-an-independent-random-secret-0001","languages":"replace-with-an-independent-random-secret-0002","finance":"replace-with-an-independent-random-secret-0003"}

# Persistent replay, rate-limit, usage, and budget counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional per-app request-rate overrides.
# Defaults: 60/minute and 1000/day per app.
THIEPN_AI_APP_POLICIES_JSON={}

# Ecosystem-wide monthly spending thresholds in USD.
THIEPN_AI_MONTHLY_WARNING_USD=2
THIEPN_AI_MONTHLY_SOFT_USD=5
THIEPN_AI_MONTHLY_HARD_USD=10
