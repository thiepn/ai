{
  "name": "@thiepn/ai-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:client": "npm run build --workspace=@thiepn/ai",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@thiepn/ai",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:static": "vitest run tests/evals.test.ts",
    "eval:live": "tsx src/evals/run-live.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.0",
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
